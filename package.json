{
  "name": "oslolatte",
  "private": true,
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kasa031/oslolatte.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/gen-theresesgate-slides.mjs && node scripts/sync-public-order-assets.mjs && vite --config vite.config.ts",
    "dev:functions": "node scripts/netlify-functions-serve.mjs",
    "telegram:chat-id": "node scripts/sync-telegram-chat-id.mjs",
    "gen:slides": "node scripts/gen-theresesgate-slides.mjs",
    "sync:order-assets": "node scripts/sync-public-order-assets.mjs",
    "env:bootstrap": "node scripts/bootstrap-env.mjs",
    "order:check-env": "node scripts/check-order-env.mjs",
    "domain:check": "node scripts/check-domain-live.mjs",
    "dev:all": "npm run order:check-env && concurrently -k \"npm run dev:functions\" \"node scripts/wait-functions-then-vite.mjs\"",
    "dev:serve": "concurrently -k \"npm run dev:functions\" \"node scripts/wait-functions-then-vite.mjs\"",
    "dev:netlify": "npm run order:check-env && npx --yes netlify-cli dev",
    "prebuild": "node scripts/gen-theresesgate-slides.mjs && node scripts/sync-public-order-assets.mjs && node scripts/bump-sw-cache.mjs",
    "build": "tsc -b && vite build --config vite.config.ts",
    "build:analyze": "npm run prebuild && tsc -b && vite build --config vite.config.ts --mode analyze",
    "preview": "vite preview --config vite.config.ts",
    "lint": "tsc -b --pretty && eslint . && npm run i18n:check && npm run test:unit && npm run verify:git-paths",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"vite.config.ts\" \"vitest.config.ts\" \"index.html\" \"playwright.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"vite.config.ts\" \"vitest.config.ts\" \"index.html\" \"playwright.config.ts\"",
    "i18n:check": "node --experimental-strip-types scripts/check-translations-keys.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "e2e:web": "concurrently --kill-others -n fn,web \"node scripts/netlify-functions-serve.mjs\" \"node scripts/wait-tcp-then-e2e-preview.mjs\"",
    "test:e2e:url": "node scripts/assert-playwright-base-url.mjs && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:git-paths": "node scripts/verify-git-path-case.mjs",
    "git:push-check": "node scripts/git-push-sanity.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.2.6",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@fontsource/great-vibes": "^5.2.8",
    "@sentry/react": "^10.53.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "image-size": "^2.0.2",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^5.14.0",
    "sharp": "^0.34.5",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.5",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.10"
  }
}
